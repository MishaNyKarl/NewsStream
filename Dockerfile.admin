FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements-admin.txt ./
RUN pip install -r requirements-admin.txt \
    && groupadd --gid 10001 adminui \
    && useradd --uid 10001 --gid 10001 --no-create-home adminui \
    && mkdir /data && chown 10001:10001 /data
COPY app/__init__.py app/models.py ./app/
COPY app/admin ./app/admin
COPY docs ./docs
USER 10001:10001
EXPOSE 8443
CMD ["python", "-m", "app.admin"]
