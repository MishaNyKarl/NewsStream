# Separate file: /etc/newswatch-admin/admin.env, mode 0600. Never reuse the bot's full .env.
DATABASE_URL=postgresql+asyncpg://newswatch:REPLACE@db:5432/newswatch
ADMIN_ORIGIN=https://169.255.57.42:8443
ADMIN_USERNAME=admin
# Generate with python -m app.admin.password. Compose env_file format: raw preserves $.
ADMIN_PASSWORD_HASH=REPLACE_WITH_ARGON2ID_HASH
ADMIN_SESSION_SECONDS=28800
ADMIN_IDLE_SECONDS=1800
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-v3.2
ADMIN_LLM_KEY_FINGERPRINT=
ADMIN_BOT_USERNAME=
ADMIN_REVISION=
ADMIN_OPS_SOCKET=/run/newswatch-admin-ops/control.sock
